---
import { CAFE_CONFIG } from '../config.js';
---

<section id="locations" class="py-24 px-6 bg-[#171715] text-white">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16">
      <span class="text-xs font-bold text-[#d58c3d] tracking-widest uppercase">{CAFE_CONFIG.locations.eyebrow}</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold uppercase mt-2">{CAFE_CONFIG.locations.headline}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {CAFE_CONFIG.locations.stores.map((store, i) => (
        <div class="border border-white/10 rounded-xl p-8 bg-[#070707] hover:border-[#d58c3d] transition-colors flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <span class="text-xs font-mono text-[#d58c3d]">LOCATION 0{i + 1}</span>
            <h3 class="text-xl font-bold uppercase">{store.name}</h3>
            <p class="text-gray-400 text-xs sm:text-sm">{store.address}</p>
          </div>

          <div class="space-y-3 pt-6 border-t border-white/10 text-xs text-gray-300">
            <div class="flex justify-between">
              <span class="text-gray-500">HOURS</span>
              <span>{store.hours}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-500">PHONE</span>
              <span>{store.phone}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>