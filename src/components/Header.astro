---
import { CAFE_CONFIG } from '../config.js';
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 px-6 py-4 transition-colors duration-300 flex items-center justify-between mix-blend-difference text-white">
  <a href="#" class="group flex items-center gap-3">
    <div class="w-9 h-9 border border-current rounded-full flex items-center justify-center font-bold tracking-tighter text-sm group-hover:bg-[#d58c3d] group-hover:text-black group-hover:border-[#d58c3d] transition-colors">
      SC
    </div>
    <div class="flex flex-col">
      <span class="font-bold tracking-widest text-sm uppercase leading-none">{CAFE_CONFIG.brand.name}</span>
      <span class="text-[10px] opacity-70 tracking-normal font-sans">{CAFE_CONFIG.brand.kurdishName}</span>
    </div>
  </a>

  <nav class="hidden md:flex items-center gap-8 text-xs tracking-widest uppercase">
    <a href="#menu" class="hover:text-[#d58c3d] transition-colors">Menu</a>
    <a href="#about" class="hover:text-[#d58c3d] transition-colors">Experience</a>
    <a href="#instagram" class="hover:text-[#d58c3d] transition-colors">Feed</a>
    <a href="#locations" class="hover:text-[#d58c3d] transition-colors">Locations</a>
  </nav>

  <div class="flex items-center gap-4">
    <a href={`tel:${CAFE_CONFIG.brand.phone}`} class="hidden sm:inline-block border border-current px-4 py-2 text-xs uppercase tracking-wider hover:bg-white hover:text-black transition-all">
      {CAFE_CONFIG.brand.phone}
    </a>
    <a href="#locations" class="bg-[#d58c3d] text-black font-bold px-4 py-2 text-xs uppercase tracking-wider hover:bg-white transition-all">
      Visit Us
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('backdrop-blur-md', 'bg-black/40');
    } else {
      header?.classList.remove('backdrop-blur-md', 'bg-black/40');
    }
  });
</script>