---
import { CAFE_CONFIG } from '../config.js';
---

<section id="menu" class="py-24 px-6 bg-[#171715] text-white relative">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-bold text-[#d58c3d] tracking-widest uppercase">{CAFE_CONFIG.menu.eyebrow}</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase mt-2">{CAFE_CONFIG.menu.headline}</h2>
      </div>
      <p class="text-gray-400 text-xs sm:text-sm max-w-md">
        Freshly brewed beans sourced micro-lots, signature layered shakes, and handcrafted seasonal beverages.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {CAFE_CONFIG.menu.items.map((item) => (
        <div class="group bg-[#070707] border border-white/10 rounded-xl overflow-hidden hover:border-[#d58c3d]/50 transition-all duration-300 flex flex-col justify-between">
          <div class="relative h-64 overflow-hidden bg-black/40">
            <img 
              src={item.image} 
              alt={item.name} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" 
            />
            <span class="absolute top-3 left-3 bg-black/70 backdrop-blur-md text-[10px] text-[#d58c3d] font-bold px-2 py-1 rounded tracking-widest">
              {item.category}
            </span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <span class="text-[10px] text-gray-500 font-mono">{item.id}</span>
              <h3 class="font-bold text-base mt-1 group-hover:text-[#d58c3d] transition-colors">{item.name}</h3>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-white/10">
              <span class="font-bold text-sm text-[#d58c3d]">{item.price}</span>
              <span class="text-[10px] uppercase tracking-wider text-gray-400 group-hover:text-white">Fresh Daily</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>