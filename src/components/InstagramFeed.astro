---

<section id="instagram" class="py-24 px-6 bg-[#070707] border-t border-white/10">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-12 gap-6">
      <div>
        <span class="text-xs font-bold text-[#d58c3d] tracking-widest uppercase">// INSTAGRAM COMMUNITY</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase mt-1">@{instagramData.username}</h2>
      </div>
      <a href="https://instagram.com/shar.coffee" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 border border-white/20 px-6 py-3 text-xs uppercase tracking-widest hover:border-[#d58c3d] hover:text-[#d58c3d] transition-all w-fit">
        <span>Follow Community ({instagramData.followers})</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {instagramData.posts.map((post) => (
        <a href="https://instagram.com/shar.coffee" target="_blank" rel="noopener noreferrer" class="group relative aspect-square rounded-xl overflow-hidden border border-white/10 bg-[#171715]">
          <img src={post.url} alt="Instagram Post" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
          <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-6 flex flex-col justify-end text-xs">
            <p class="text-white line-clamp-3 font-sans">{post.caption}</p>
            <span class="mt-3 text-[#d58c3d] font-bold uppercase tracking-wider text-[10px]">View on Instagram →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>